{
  "name": "bulk-core-web-vitals-checker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bulk Core Web Vitals checker that runs Lighthouse audits in the cloud.",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint:readme": "markdownlint-cli2 README.md"
  },
  "dependencies": {
    "@apify-actors/common": "workspace:*",
    "apify": "3.7.2",
    "chrome-launcher": "1.2.1",
    "lighthouse": "13.5.0",
    "robots-parser": "3.0.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.10",
    "markdownlint-cli2": "^0.18.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
