{
  "name": "apify-actors",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "lint": "eslint .",
    "typecheck": "pnpm --filter @apify-actors/common build && pnpm -r --if-present typecheck",
    "test": "vitest run --config vitest.config.ts && pnpm -r --if-present test"
  },
  "devDependencies": {
    "@apify/input_schema": "4.0.5",
    "@eslint/js": "^9.36.0",
    "@types/node": "^22.18.6",
    "ajv": "^8.17.1",
    "eslint": "^9.36.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vitest": "^3.2.4"
  }
}
